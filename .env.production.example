# Copia aquest fitxer a server/.env i configura els valors abans de desplegar.
BASE_URL=https://el-teu-domini
PORT=3001
NODE_ENV=production
DATABASE_URL=file:./production.db

# Obligatori en produccio
SESSION_SECRET=canvia-aquest-secret

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: llista separada per comes de professors inicials
SEED_TEACHERS=
