generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String?
  role         String    @default("STUDENT") // STUDENT | TEACHER
  googleTokens String? // JSON amb tokens del professor (Classroom)
  quizzes      Quiz[]
  attempts     Attempt[]
  createdAt    DateTime  @default(now())
}

model Quiz {
  id                    Int        @id @default(autoincrement())
  title                 String
  description           String     @default("")
  teacherId             Int
  teacher               User       @relation(fields: [teacherId], references: [id])
  maxScore              Float      @default(10)
  shuffleQuestions      Boolean    @default(false)
  allowRetry            Boolean    @default(false)
  maxAttempts           Int        @default(1)
  negativePenalty       Float      @default(0) // fracció de punts de la pregunta que resta cada error (0 = no resta)
  gradeToExport         String     @default("BEST") // BEST | LAST
  showResults           String     @default("SCORE") // NONE | SCORE | FULL | ANSWERS
  showResultsFrom       DateTime? // si està definit, els resultats només es veuen a partir d'aquesta data
  published             Boolean    @default(true)
  publicSlug            String     @unique
  gradingVersion        Int        @default(0)
  questions             Question[]
  groups                QuestionGroup[]
  attempts              Attempt[]
  classrooms            QuizClassroom[]
  extensions            QuizExtension[]
  createdAt             DateTime   @default(now())
}

model QuizClassroom {
  id           Int    @id @default(autoincrement())
  quizId       Int
  quiz         Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  courseId     String
  courseWorkId String
  courseName   String @default("")

  @@unique([quizId, courseId])
}

// Pròrroga manual del termini per a un alumne concret; només pot allargar, mai escurçar.
model QuizExtension {
  id        Int      @id @default(autoincrement())
  quizId    Int
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  email     String // sempre en minúscules, com a User.email
  name      String   @default("")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([quizId, email])
}

model QuestionGroup {
  id        Int        @id @default(autoincrement())
  quizId    Int
  quiz      Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text      String     @default("")
  questions Question[]
}

model Question {
  id             Int      @id @default(autoincrement())
  quizId         Int
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  sectionTitle   String? // si està definit, aquí comença una secció nova
  groupId        Int?
  group          QuestionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  type           String // MCQ | TRUE_FALSE | MATCHING | IMAGE_LABEL | SHORT_TEXT | LONG_TEXT | IMAGE_UPLOAD | FILL_BLANKS
  text           String
  imageUrl       String?
  points         Float    @default(1)
  required       Boolean  @default(true)
  shuffleOptions Boolean  @default(true)
  order          Int      @default(0)
  gradingVersion Int     @default(0)
  gradingCriteria String?
  linkedQuestionId Int? // pregunta anterior de què depèn la resposta; invisible per a l'alumne
  linkedQuestion Question?  @relation("QuestionLink", fields: [linkedQuestionId], references: [id], onDelete: SetNull)
  linkedFrom     Question[] @relation("QuestionLink")
  config         String   @default("{}") // JSON visible a l'alumne
  answerKey      String   @default("{}") // JSON només professor
  answers        Answer[]
  llmRuns        LlmRun[]
}

// Una crida a la LLM (pot cobrir diverses respostes) amb el prompt i la resposta crua.
model LlmRun {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  provider   String
  model      String
  webSearch  Boolean  @default(false)
  prompt     String
  response   String
  createdAt  DateTime @default(now())
  answers    Answer[]
}

model Attempt {
  id          Int       @id @default(autoincrement())
  quizId      Int
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  seed        Int
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Float?
  status      String    @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | NEEDS_REVIEW | GRADED
  exportedAt  DateTime?
  exportedScore Float?
  gradedVersion Int       @default(0)
  answers     Answer[]
}

model Answer {
  id          Int      @id @default(autoincrement())
  attemptId   Int
  attempt     Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  Int
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value       String   @default("null") // JSON
  fileUrl     String?
  score       Float?
  needsReview Boolean  @default(false)
  manuallyReviewed Boolean @default(false)
  llmReviewed Boolean @default(false)
  llmRunId    Int?
  llmRun      LlmRun?  @relation(fields: [llmRunId], references: [id], onDelete: SetNull)
  feedback    String?
  questionGradingVersion Int @default(0)

  @@unique([attemptId, questionId])
}
